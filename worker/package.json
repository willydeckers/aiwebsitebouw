{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spec v9 section 2: separate hosted worker for 'zware taken' (review-loop with Playwright, Shopify store building) that can't run in a Deno Edge Function or a static frontend.",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:site-builder": "tsx scripts/test-site-builder.ts",
    "test:site-widgets": "tsx scripts/test-site-widgets.ts",
    "test": "npm run test:site-builder && npm run test:site-widgets && npm run test:shopify-mapping",
    "test:shopify-mapping": "tsx scripts/test-site-naar-shopify.ts",
    "bundel": "tsx scripts/bundel.ts",
    "pak-in": "npm run bundel && tsx scripts/pak-in.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.1",
    "@supabase/supabase-js": "^2.110.7",
    "playwright": "^1.50.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
