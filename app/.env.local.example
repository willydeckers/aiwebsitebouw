# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL the track-and-serve Edge Function is reachable at (spec
# section 2 — a custom domain mapped to that function, e.g.
# https://demo.jouwagency.be). Used to build both the public demo link
# (/{leadId}) and the send-email tracking link (/t/{leadId}). Safe to
# expose client-side — it's just a public routing prefix, no secret.
NEXT_PUBLIC_DEMO_HOSTING_URL=

# Google OAuth client ID (spec section 2/7 — per-user Gmail linking from
# Voorkeuren). Client IDs are not secret; the matching client secret lives
# server-side only, as an Edge Function env var (see supabase/README.md).
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Everything else (ANTHROPIC_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# GOOGLE_OAUTH_CLIENT_SECRET, GMAIL_TOKEN_ENCRYPTION_KEY,
# SHOPIFY_PARTNER_*, MODEL_KWALITEIT, MODEL_SOURCING,
# GOOGLE_PLACES_API_KEY, DEMO_HOSTING_URL) is server-only and belongs in
# Supabase Edge Function secrets (`supabase secrets set ...`) or the
# worker's own environment, NOT here — this is a static-export app with
# no server runtime, so nothing in .env.local can stay secret. See
# supabase/README.md for the full list and what each one is used by.
