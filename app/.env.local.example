# Copy to .env.local and fill in from your Supabase project settings.
# Never commit .env.local — it's already in .gitignore.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — used by the research/generation/review/chat-edit pipeline
# (spec section 2). Never expose this to the client.
ANTHROPIC_API_KEY=

# Service-role key (Supabase project settings -> API). Server-only — used by
# the public tracking redirect (app/api/track/[leadId]) which runs without an
# authenticated dashboard session. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail API (spec section 3.6) — a Google Cloud OAuth client + a one-time
# refresh token for the sending Gmail account. Server-only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Base URL this app is reachable at — used to build the tracking link sent
# to leads. Defaults to http://localhost:3000 in dev if unset.
NEXT_PUBLIC_APP_URL=

# Shopify Partner API (spec section 3.8) — used to create development
# stores on customer conversion. Server-only. The exact
# developmentStoreCreate mutation shape in lib/shopify/create-dev-store.ts
# has not been verified against live Shopify docs — see the note there.
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_ACCESS_TOKEN=
