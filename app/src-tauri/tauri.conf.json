{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Web Agency Dashboard",
  "version": "0.1.0",
  "identifier": "be.webagency.dashboard",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Web Agency Dashboard",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Web Agency",
    "copyright": "Web Agency",
    "shortDescription": "Dashboard voor leads, demo-sites en klanten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Dutch",
          "English"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "resources/worker/**/*"
    ]
  }
}
