{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "app",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "dashboard-statisch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "out",
        "-p",
        "3100",
        "-s"
      ],
      "cwd": "app",
      "port": 3100,
      "autoPort": false
    },
    {
      "name": "sitedemo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "widgetdemo",
        "-p",
        "3200"
      ],
      "cwd": "worker",
      "port": 3200,
      "autoPort": false
    }
  ]
}
